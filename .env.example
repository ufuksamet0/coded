# Coded Environment Variables
# Copy this file to .env and fill in your values

# Model Provider API Keys
# At least one is required for cloud models
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: Custom base URLs for providers
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com

# Local Model (Ollama, LM Studio, etc.)
# OLLAMA_HOST=http://127.0.0.1:11434/v1

# Default model to use (provider/model format)
# CODED_MODEL=anthropic/claude-sonnet-4-5

# UI theme: dark, light, or auto
# CODED_THEME=dark

# Custom config file path
# CODED_CONFIG=/path/to/config.json

# Custom home directory for config and sessions
# CODED_HOME=~/.coded

# Enable debug logging
# CODED_DEBUG=1