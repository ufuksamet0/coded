{
  "name": "@coded/cli",
  "version": "0.1.0",
  "description": "Coded — an AI coding agent in your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "coded": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
