  },
  "dependencies": {
    "@coded/core": "workspace:*",
    "fast-glob": "^3.3.2",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
