{
  "name": "coded",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, model-agnostic AI coding assistant for the terminal and desktop.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @coded/cli dev",
    "dev:desktop": "pnpm --filter @coded/desktop dev",
    "typecheck": "pnpm --filter @coded/core typecheck && pnpm --filter @coded/cli typecheck && pnpm --filter @coded/desktop typecheck",
    "test": "pnpm --filter @coded/core test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "cli": "pnpm --filter @coded/cli start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
